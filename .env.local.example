# 이 파일을 복사해서 `.env.local` 로 만들고, 실제 값을 채워 넣으세요.
#   - .env.local 은 .gitignore 에 포함되어 절대 커밋되지 않습니다.
#   - 값에 따옴표는 붙이지 마세요. (예: NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co)

# ── Supabase ──────────────────────────────────────────────
# Supabase 대시보드 > Project Settings > Data API / API Keys 에서 복사
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role 키는 RLS를 우회하는 관리자 키입니다. 서버에서만 사용하고 절대 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=

# ── CORS ──────────────────────────────────────────────────
# 프론트엔드(daramjwi-taxi-client) 주소. 쉼표로 여러 개 가능.
# 비워두거나 * 이면 모든 주소 허용(개발용). 실제 배포 시엔 프론트 주소만 적으세요.
# 예: ALLOWED_ORIGINS=http://localhost:3001,https://daramjwi.vercel.app
ALLOWED_ORIGINS=*

# ── SMS (NHN Cloud Notification 또는 CoolSMS) — Phase 8에서 사용 ──
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_NUMBER=
